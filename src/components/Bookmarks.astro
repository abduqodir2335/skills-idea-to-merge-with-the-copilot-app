---
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="url"
      spellcheck="false"
      placeholder="example.com"
      required
      aria-describedby="url-hint"
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="url-hint" class="hint">Paste a link with or without <code>https://</code>. Your short slug is generated on this device.</p>
<p id="status" class="status" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>

<script>
  import { formatBookmark, normalizeUrl, parseBookmarks } from '../lib/bookmarks.js';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('status');
  const clearButton = document.getElementById('clear-all');
  let bookmarks = [];

  function showStatus(message, isError = false) {
    status.textContent = message;
    status.classList.toggle('error', isError);
  }

  function renderBookmarks() {
    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      slug.setAttribute('aria-label', `Bookmark slug ${bookmark.slug}`);

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy slug';
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showStatus(`Copied ${bookmark.slug}.`);
        } catch {
          showStatus('Could not access the clipboard. Select and copy the slug instead.', true);
        }
      });

      item.append(link, separator, slug, copyButton);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  function loadSavedBookmarks() {
    try {
      bookmarks = parseBookmarks(window.localStorage.getItem(storageKey));
    } catch {
      bookmarks = [];
      showStatus('Browser storage is unavailable. Bookmarks will not persist in this browser.', true);
    }
    renderBookmarks();
  }

  function saveBookmarks() {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(bookmarks));
      return true;
    } catch {
      showStatus('Could not save to browser storage. Check your browser storage settings.', true);
      return false;
    }
  }

  function generateSlug() {
    const alphabet = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
    const bytes = new Uint8Array(4);
    try {
      window.crypto.getRandomValues(bytes);
    } catch {
      for (let index = 0; index < bytes.length; index += 1) {
        bytes[index] = Math.floor(Math.random() * 256);
      }
    }
    return `mona-${Array.from(bytes, (byte) => alphabet[byte % alphabet.length]).join('')}`;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const normalizedUrl = normalizeUrl(urlInput.value);
    if (!normalizedUrl) {
      showStatus('Enter a valid web address, such as example.com.', true);
      urlInput.focus();
      return;
    }

    let slug = generateSlug();
    while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
      slug = generateSlug();
    }

    bookmarks.push({ url: normalizedUrl, slug });
    renderBookmarks();
    if (saveBookmarks()) {
      showStatus(`Saved ${formatBookmark({ url: normalizedUrl, slug })}.`);
    }
    form.reset();
    urlInput.focus();
  });

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks from this browser?')) return;
    try {
      window.localStorage.removeItem(storageKey);
      bookmarks = [];
      renderBookmarks();
      showStatus('All bookmarks cleared.');
    } catch {
      showStatus('Could not clear browser storage. Check your browser storage settings.', true);
    }
  });

  loadSavedBookmarks();
</script>
