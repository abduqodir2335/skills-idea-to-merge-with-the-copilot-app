---
const { title = "Mona's Bookmark Manager App" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light;
        --accent: #215e52;
        --accent-strong: #17473d;
        --border: #d7d9d1;
        --muted: #656a63;
        --surface: #fffefa;
        --surface-soft: #f3f2e9;
        --radius: 1rem;
        --shadow: 0 1.5rem 4rem #293c3020;
        --font-body: 'Monaspace Neon', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        --font-head: 'Monaspace Xenon', 'Monaspace Neon', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      body {
        min-height: 100vh;
        font-family: var(--font-body);
        line-height: 1.5;
        max-width: 48rem;
        margin: 0 auto;
        padding: clamp(2.5rem, 8vh, 5rem) 1.25rem 3rem;
        color: #252b27;
        background:
          radial-gradient(ellipse at 90% 4%, #d7e7d8 0, transparent 34rem),
          linear-gradient(145deg, #f8f6ec, #edf2e8 70%, #e8efe7);
      }
      header { margin: 0 auto 1.5rem; max-width: 42rem; }
      h1 {
        margin: 0 0 0.55rem;
        font-size: clamp(1.7rem, 5vw, 2.2rem);
        font-family: var(--font-head);
        letter-spacing: -0.04em;
        line-height: 1.2;
      }
      .tagline { margin: 0; color: var(--muted); }
      main {
        padding: clamp(1.1rem, 4vw, 2rem);
        border: 1px solid #ffffffb8;
        border-radius: 1.4rem;
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: end;
        margin: 1.5rem 0 0.5rem;
      }
      .field { display: flex; flex-direction: column; gap: 0.35rem; flex: 1 1 16rem; }
      label { font-size: 0.85rem; font-weight: 600; }
      input {
        padding: 0.6rem 0.7rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font: inherit;
        background: transparent;
        color: inherit;
      }
      input:focus-visible,
      button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      button {
        padding: 0.6rem 1rem;
        border: 1px solid transparent;
        border-radius: var(--radius);
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover { background: var(--accent-strong); }
      .hint { margin: 0 0 1.5rem; font-size: 0.8rem; color: var(--muted); }
      .status { min-height: 1.5em; margin: -0.9rem 0 0.9rem; font-size: 0.78rem; color: var(--accent-strong); }
      .status:empty { display: none; }
      .status.error { color: #a33a32; }

      #list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0.5rem 0;
      }
      .list-title { margin: 0; font-size: 1rem; font-family: var(--font-head); }
      .clear {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .clear:hover { border-color: currentColor; }

      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.65rem; }
      li.bookmark {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 0.6rem;
        padding: 0.75rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface-soft);
      }
      .bookmark .url { flex: 1 1 12rem; overflow-wrap: anywhere; color: var(--accent-strong); }
      .bookmark .separator { color: var(--muted); white-space: pre; }
      .bookmark .slug {
        font-family: var(--font-body);
        font-size: 0.85rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: #dce9df;
      }
      .bookmark .copy {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .empty {
        margin: 0;
        padding: 1.5rem;
        text-align: center;
        color: var(--muted);
        border: 1px dashed #c5c9bf;
        border-radius: var(--radius);
        background: var(--surface-soft);
      }

      footer { margin-top: 1.5rem; font-size: 0.75rem; color: var(--muted); text-align: center; }
      @media (max-width: 30rem) {
        form button { width: 100%; }
        .bookmark .separator { margin-left: -0.4rem; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
